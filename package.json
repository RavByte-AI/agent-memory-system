{
  "name": "@ravbyte/agent-memory-system",
  "version": "0.1.1",
  "description": "Generate and maintain AI-readable project memory, worklogs, and handoffs for any repository.",
  "type": "module",
  "license": "MIT",
  "author": "Gaurav Singh",
  "homepage": "https://www.ravbyte.com",
  "agentMemory": {
    "founder": "Gaurav Singh",
    "company": "RAVBYTE TECHNOLOGIES PRIVATE LIMITED",
    "website": "https://www.ravbyte.com",
    "x": "https://x.com/gauravchadhry",
    "linkedin": "https://www.linkedin.com/in/gauravchadhry/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/RavByte-AI/agent-memory-system"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "agent-memory": "./dist/cli/index.js",
    "agent-memory-system": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "src/agent-skill",
    "docs/agent-skill.md",
    "docs/assets",
    "docs/index.html",
    "docs/styles.css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli/index.ts --format esm --dts --clean --sourcemap",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "memory:maintain": "tsx src/cli/index.ts maintain",
    "memory:check": "tsx src/cli/index.ts maintain --check"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "fast-check": "^3.23.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
